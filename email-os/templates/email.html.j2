{#- Email-safe, table-based, inline styles. Colours come only from brand tokens. -#}
{%- set B = brand -%}
{%- set N = B.colors.neutrals -%}
{%- macro button(btn) -%}
<a href="{{ btn.href }}" style="display:inline-block;background:{{ N[3] }};color:{{ N[0] }};font-size:13px;letter-spacing:0.1em;text-transform:uppercase;font-weight:500;text-decoration:none;padding:15px 28px;">{{ btn.label }}</a>
{%- endmacro -%}
<!doctype html>
<html lang="{{ locale }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<title>{{ subject }}</title>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body style="margin:0;padding:0;background:{{ N[1] }};">
<div style="display:none;max-height:0;overflow:hidden;">{{ preview }}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{{ N[1] }};">
<tr><td align="center" style="padding:0;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:100%;background:{{ N[0] }};font-family:{{ B.fonts.body }};color:{{ N[4] }};">
{%- for b in blocks %}
{%- if b.type == "logo" %}
<tr><td align="center" style="padding:28px 24px 20px;border-bottom:1px solid {{ N[2] }};">
  {%- if B.logo_url %}<img src="{{ B.logo_url }}" alt="{{ B.name }}" width="140" style="display:block;border:0;">
  {%- else %}<span style="font-family:{{ B.fonts.wordmark }};font-size:26px;letter-spacing:0.18em;color:{{ N[3] }};">{{ B.wordmark }}</span>{% endif %}
</td></tr>
{%- elif b.type == "hero" %}
<tr><td style="padding:0;"><a href="{{ b.href }}"><img src="{{ b.image.src }}" alt="{{ b.image.alt }}" width="600" style="display:block;width:100%;height:auto;border:0;"></a></td></tr>
<tr><td style="padding:32px 40px 8px;">
  {%- if b.label %}<div style="font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:{{ B.colors.accent }};font-weight:600;padding-bottom:12px;">{{ b.label }}</div>{% endif %}
  <div style="font-size:34px;line-height:1.15;font-weight:300;color:{{ N[3] }};">{{ b.headline }}</div>
  {%- if b.body %}<div style="font-size:15px;line-height:1.6;color:{{ N[5] }};padding-top:14px;">{{ b.body }}</div>{% endif %}
</td></tr>
{%- if b.button %}<tr><td style="padding:20px 40px 36px;">{{ button(b.button) }}</td></tr>{% endif %}
{%- elif b.type == "text" %}
<tr><td style="padding:28px 40px;">
  {%- if b.title %}<div style="font-size:20px;line-height:1.3;font-weight:400;color:{{ N[3] }};padding-bottom:10px;">{{ b.title }}</div>{% endif %}
  <div style="font-size:15px;line-height:1.6;color:{{ N[5] }};">{{ b.body }}</div>
</td></tr>
{%- elif b.type == "offer_card" %}
<tr><td style="padding:12px 40px 28px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{{ N[1] }};border:1px solid {{ N[2] }};">
<tr><td style="padding:24px 28px;">
  <div style="font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:{{ B.colors.accent }};font-weight:600;">{{ b.label }}</div>
  <div style="font-size:28px;line-height:1.2;font-weight:300;color:{{ N[3] }};padding-top:8px;">{{ b.title }}</div>
  {%- if b.body %}<div style="font-size:14px;line-height:1.6;color:{{ N[5] }};padding-top:8px;">{{ b.body }}</div>{% endif %}
</td></tr></table>
</td></tr>
{%- elif b.type == "section_header" %}
<tr><td style="padding:28px 40px 0;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-bottom:1px solid {{ N[3] }};"><tr>
  <td style="font-size:12px;letter-spacing:0.12em;text-transform:uppercase;font-weight:600;color:{{ N[3] }};padding-bottom:8px;">{{ b.title }}</td>
  <td align="right" style="font-size:12px;color:{{ N[6] }};padding-bottom:8px;">{{ b.note or "" }}</td>
</tr></table></td></tr>
{%- elif b.type == "product" %}
<tr><td style="padding:24px 40px;border-bottom:1px solid {{ N[2] }};">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
  <td width="240" valign="top"><a href="{{ b.href }}"><img src="{{ b.image.src }}" alt="{{ b.image.alt }}" width="240" style="display:block;width:240px;height:auto;border:0;background:{{ N[1] }};"></a></td>
  <td valign="middle" style="padding-left:24px;">
    <div style="font-size:18px;font-weight:400;color:{{ N[3] }};">{{ b.name }}</div>
    {%- if b.body %}<div style="font-size:14px;line-height:1.5;color:{{ N[5] }};padding-top:6px;">{{ b.body }}</div>{% endif %}
    <div style="font-size:15px;padding-top:10px;">
      {%- if b.was %}<span style="color:{{ N[6] }};text-decoration:line-through;">{{ b.was }}</span>&nbsp; <span style="color:{{ B.colors.accent }};font-weight:500;">{{ b.now }}</span>
      {%- else %}<span style="color:{{ N[3] }};font-weight:500;">{{ b.now }}</span>{% endif %}
    </div>
    <div style="padding-top:16px;">{{ button(b.button) }}</div>
  </td>
</tr></table></td></tr>
{%- elif b.type == "review" %}
<tr><td style="padding:32px 40px;" align="center">
  <div style="font-size:14px;color:{{ N[3] }};letter-spacing:0.1em;">{{ "★" * b.rating }}</div>
  <div style="font-size:17px;line-height:1.5;font-weight:300;color:{{ N[3] }};padding-top:10px;">&ldquo;{{ b.text }}&rdquo;</div>
  <div style="font-size:12px;color:{{ N[6] }};padding-top:10px;">{{ b.author }} · {{ b.platform }}</div>
</td></tr>
{%- elif b.type == "button" %}
<tr><td align="center" style="padding:24px 40px 32px;">{{ button(b.button) }}</td></tr>
{%- elif b.type == "trust" %}
<tr><td align="center" style="padding:20px 40px;font-size:13px;color:{{ N[5] }};border-top:1px solid {{ N[2] }};">{{ B.trust_line }}</td></tr>
{%- elif b.type == "footer" %}
<tr><td align="center" style="padding:28px 40px 40px;background:{{ N[1] }};font-size:11px;line-height:1.6;color:{{ N[6] }};">
  {{ b.text }}<br>{% raw %}{{ organization.name }} · {{ organization.full_address }}{% endraw %}<br><a href="{% raw %}{% unsubscribe_url %}{% endraw %}" style="color:{{ N[6] }};">{{ b.unsubscribe }}</a>
</td></tr>
{%- endif %}
{%- endfor %}
</table>
</td></tr></table>
</body>
</html>
